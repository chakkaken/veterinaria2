DJANGO_SECRET_KEY=your-secret-key-here
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,your-app.onrender.com
DATABASE_URL=postgresql://user:password@host:5432/dbname

# Opción 1 (recomendada para Render): SendGrid
SENDGRID_API_KEY=your-sendgrid-api-key
DEFAULT_FROM_EMAIL=tu-correo@dominio.com

# Opción 2: Gmail SMTP (puede ser bloqueado por Google en Render)
EMAIL_HOST_USER=your-email@gmail.com
EMAIL_HOST_PASSWORD=your-app-password
